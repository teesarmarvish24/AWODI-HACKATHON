# ── Core LLM (set at least ONE of the two blocks below) ──────────────
# Powers language understanding, scam-risk reasoning, and localized replies.
# Anthropic is used first if both are set. With neither set, the app still
# runs on a small offline rule-based fallback (fine for dev, not for judging).

# Option A — Anthropic (requires a small prepaid credit balance).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5. Use claude-haiku-4-5-20251001 for a
# cheaper/faster model if you're burning through demo credits.
ANTHROPIC_MODEL=

# Option B — Google Gemini (FREE tier, no credit card required). Used
# automatically when ANTHROPIC_API_KEY is not set. Get a key in under a
# minute at https://aistudio.google.com/apikey — this is the $0 path.
GEMINI_API_KEY=
# Optional — defaults to gemini-2.0-flash.
GEMINI_MODEL=

# ── Data layer (optional — falls back to bundled local JSON store) ──
# Leave both blank to run entirely on the seeded local dataset in data/seed/.
# Set both to point Awòdì at a real Supabase project (see db/schema.sql).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp channel (required only for the live Twilio webhook) ────
# Get these from the Twilio Console after joining the WhatsApp Sandbox:
# https://www.twilio.com/docs/whatsapp/sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Voice input (optional bolt-on — text flow works without it) ─────
# Transcribes trader voice notes before they hit the pipeline.
# Get a key at https://platform.openai.com
OPENAI_API_KEY=

# ── Voice output (optional bolt-on — enable once text flow is stable) ─
# YarnGPT Nigerian-accented TTS via a Hugging Face Inference Endpoint.
# https://huggingface.co/saheedniyi/YarnGPT
YARNGPT_HF_ENDPOINT_URL=
YARNGPT_HF_API_TOKEN=

# ── Server ────────────────────────────────────────────────────────
PORT=3000
